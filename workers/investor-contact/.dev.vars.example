# Copy to .dev.vars (gitignored) for `npm run dev`. These values are safe:
# Cloudflare's published always-pass Turnstile test secret, and DRY_RUN so
# nothing is actually sent.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
DRY_RUN=true
REPLY_TO=replies@example.com
RESEND_API_KEY=unused-in-dry-run
FORMSPREE_ENDPOINT=https://formspree.io/f/unused-in-dry-run
